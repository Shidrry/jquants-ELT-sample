config {
  type: "table",
  schema: env.martDataset,
  description: "日次株価基本指標（enriched）。価格・出来高指標、各種フラグ、銘柄マスタ属性、時価総額、財務開示日、決算コンテキストを提供する。プライム・グロース・スタンダード市場のみ対象。"
}

/*
  int_daily_price_metrics（価格・技術指標 layer）をベースに、
  銘柄マスタ・財務情報・決算カレンダーを各 trade_date 時点で LEFT JOIN して結合する。

  各 trade_date 時点の参照データ:
    - latest_master    : valid_from/valid_to で時点スナップショットを参照
    - latest_fins      : DiscDate < trade_date の最新「決算短信」開示を参照
    - latest_revisions : DiscDate < trade_date の最新「修正開示」を参照
    - announcement_history / next_earnings : logical_date 以前の決算カレンダーから次回決算日を算出

  売買代金ランキングはここで計算（市場フィルタ後の全銘柄中）
*/

WITH

-- 各 trade_date 時点の最新銘柄マスタスナップショット（monthly ingest）
-- LEAD で valid_to を計算し、trade_date がその有効期間内の行を INNER JOIN で参照する
latest_master AS (
  SELECT
    Code AS code,
    CoName AS company_name,
    S33Nm AS sector_33,
    MktNm AS market_division,
    logical_date AS valid_from,
    LEAD(logical_date) OVER (PARTITION BY Code ORDER BY logical_date) AS valid_to
  FROM ${ref("master")}
),

-- 各 trade_date 時点で確報済みの最新「決算短信」開示（ShOutFY / TrShFY から実質流通株式数を算出）
-- DiscDate < trade_date で当日分を除外し、DocType で修正開示を除く
latest_fins AS (
  SELECT
    base.trade_date,
    base.code,
    MAX(f.DiscDate) AS last_disclosure_date,
    ARRAY_AGG(
      f.ShOutFY - COALESCE(f.TrShFY, 0)
      ORDER BY f.DiscDate DESC LIMIT 1
    )[SAFE_OFFSET(0)] AS latest_net_shares
  FROM (SELECT DISTINCT trade_date, code FROM ${ref("int_daily_price_metrics")}) AS base
  LEFT JOIN ${ref("fins_summary")} AS f
    ON f.Code = base.code
    AND f.DiscDate IS NOT NULL
    AND f.DiscDate < base.trade_date
    AND f.DocType LIKE '%FinancialStatements%'
  GROUP BY base.trade_date, base.code
),

-- 各 trade_date 時点の最新修正開示日（業績予想・配当予想の修正）
latest_revisions AS (
  SELECT
    base.trade_date,
    base.code,
    MAX(f.DiscDate) AS last_revision_date
  FROM (SELECT DISTINCT trade_date, code FROM ${ref("int_daily_price_metrics")}) AS base
  LEFT JOIN ${ref("fins_summary")} AS f
    ON f.Code = base.code
    AND f.DiscDate IS NOT NULL
    AND f.DiscDate < base.trade_date
    AND f.DocType NOT LIKE '%FinancialStatements%'
  GROUP BY base.trade_date, base.code
),

-- 決算発表日一覧（logical_date 以前の最新スナップショット）
announcement_history AS (
  SELECT DISTINCT
    Code AS code,
    Date AS announcement_date,
    FQ   AS earnings_quarter,
    execution_date
  FROM ${ref("earnings_calendar")}
  WHERE Date IS NOT NULL
    AND execution_date < CAST('${env.logical_date}' AS DATE)
),

-- 各 trade_date の次回決算予定日
next_earnings AS (
  SELECT
    p.trade_date,
    p.code,
    MIN(a.announcement_date) AS next_earnings_date
  FROM ${ref("int_daily_price_metrics")} AS p
  LEFT JOIN announcement_history AS a
    ON p.code = a.code
    AND a.execution_date < p.trade_date
    AND a.announcement_date >= p.trade_date
  GROUP BY p.trade_date, p.code
)

SELECT
  p.trade_date,
  p.code,

  -- 銘柄マスタ属性
  lm.company_name,
  lm.sector_33,
  lm.market_division,

  -- 価格情報
  p.open_price,
  p.high_price,
  p.low_price,
  p.close_price,
  p.adj_close,
  p.adjustment_factor,
  p.adj_close_api,

  -- 出来高・売買代金
  p.volume,
  p.adj_volume,
  p.turnover_value,

  -- 売買代金ランキング（市場フィルタ後の全銘柄中。1 = 最大）
  DENSE_RANK() OVER (PARTITION BY p.trade_date ORDER BY p.turnover_value DESC NULLS LAST) AS turnover_rank,

  -- 時価総額（百万円）= close_price × (ShOutFY - TrShFY) / 1,000,000
  SAFE_DIVIDE(p.close_price * lf.latest_net_shares, 1000000) AS market_cap_million_jpy,

  -- 前n営業日比 株価変化率
  p.price_pct_change_1d,
  p.price_pct_change_5d,
  p.price_pct_change_20d,
  p.price_pct_change_60d,

  -- 前n営業日比 売買代金増加率
  p.turnover_pct_change_1d,
  p.turnover_pct_change_5d,
  p.turnover_pct_change_20d,
  p.turnover_pct_change_60d,

  -- 前日比 調整後出来高増加率
  p.volume_pct_change_1d,

  -- フラグ
  p.is_bullish,
  p.had_stop_high_5d,
  p.had_stop_low_5d,

  -- 長期窓指標（前日までの最高値・平均売買代金）
  p.high_252d_prior,
  p.high_126d_prior,
  p.avg_prior_20d_turnover,
  p.adj_close > p.high_252d_prior AS is_new_252d_high,
  p.adj_close > p.high_126d_prior AS is_new_126d_high,

  -- 決算コンテキスト
  ne.next_earnings_date,
  DATE_DIFF(ne.next_earnings_date, p.trade_date, DAY)   AS days_to_next_earnings,
  ah_next.earnings_quarter                               AS next_earnings_quarter,
  lf.last_disclosure_date                                AS last_earnings_date,
  DATE_DIFF(p.trade_date, lf.last_disclosure_date, DAY)  AS days_since_last_earnings,
  lr.last_revision_date,
  DATE_DIFF(p.trade_date, lr.last_revision_date, DAY)    AS days_since_last_revision

FROM ${ref("int_daily_price_metrics")} AS p
INNER JOIN latest_master AS lm
  ON p.code = lm.code
  AND p.trade_date >= lm.valid_from
  AND (lm.valid_to IS NULL OR p.trade_date < lm.valid_to)
  AND lm.market_division IN ('プライム', 'グロース', 'スタンダード')
LEFT JOIN latest_fins AS lf
  ON p.code = lf.code
  AND p.trade_date = lf.trade_date
LEFT JOIN latest_revisions AS lr
  ON p.code = lr.code
  AND p.trade_date = lr.trade_date
LEFT JOIN next_earnings AS ne
  ON p.trade_date = ne.trade_date
  AND p.code = ne.code
LEFT JOIN announcement_history AS ah_next
  ON p.code = ah_next.code
  AND ne.next_earnings_date = ah_next.announcement_date
